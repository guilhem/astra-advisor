{
  "description": "Route unpinned native agent spawns through Jev Choice.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/jev_router.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
